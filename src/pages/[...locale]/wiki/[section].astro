---
import Page from '../../../layouts/Page.astro';
import Icon from '../../../components/Icon.astro';
import Tag from '../../../components/Tag.astro';
import { LOCALES, localeOf, t, href, asset } from '../../../i18n';
import { SECTIONS, fill } from '../../../data/wiki';
import blocks from '../../../data/game/blocks.json';
import design from '../../../data/game/design.json';
import status from '../../../data/game/status.json';
import itemsData from '../../../data/game/items.json';
import recipesData from '../../../data/game/recipes.json';
import loot from '../../../data/game/loot.json';
import mobsData from '../../../data/game/mobs.json';
import bossesData from '../../../data/game/bosses.json';
import crops from '../../../data/game/crops.json';
import fish from '../../../data/game/fish.json';
import foods from '../../../data/game/foods.json';
import buffs from '../../../data/game/buffs.json';
import smelting from '../../../data/game/smelting.json';
import tuning from '../../../data/game/tuning.json';
import home from '../../../data/game/home.json';
import skills from '../../../data/game/skills.json';
export function getStaticPaths() {
  // The guide is its own page (guide.astro).
  return LOCALES.flatMap((l) => SECTIONS.filter((s) => s.id !== 'guide').map((s) => ({ params: { locale: l === 'en' ? undefined : l, section: s.id }, props: { section: s } })));
}
const { section } = Astro.props;
const locale = localeOf(Astro.params.locale);
const d = t(locale), w = d.wiki, c = w.cols, h = w.heads, kv = w.kv;
const [title, lede] = w.sections[section.id];
const planned = 'planned' in section;

// Game data stays English: names come from the data files.
type Cell = string | { icon: string; text: string };
type Table = { title?: string; planned?: boolean; cols: string[]; rows: Cell[][] };
const none = (v: unknown) => (v === '' || v == null ? w.none : String(v));
const label = (id: string) => id.replace(/_/g, ' ');
const n = (v: number) => String(+v.toFixed(2));
const pct = (v: number) => `${+(v * 100).toFixed(1)}%`;
const dur = (s: number) => (s >= 60 ? `${n(s / 60)} min` : `${n(s)} s`);
const range = ([a, b]: number[]) => (a === b ? n(a) : `${n(a)}–${n(b)}`);
const item: Record<string, any> = Object.fromEntries(itemsData.items.map((i) => [i.id, i]));
const nameOf = (id: string) => item[id]?.name ?? label(id);
const ic = (id: string, text = nameOf(id)): Cell => ({ icon: item[id]?.icon ?? id, text });
const stack = (x: { item: string; count: number }) => `${x.count} × ${x.item.startsWith('#') ? `any ${x.item.slice(1)}` : nameOf(x.item)}`;
const list = (xs: string[]) => xs.join(', ');
const tree: Record<string, any> = Object.fromEntries(skills.trees.map((tr: any) => [tr.id, tr]));
const perks: Record<string, string> = Object.fromEntries(skills.trees.flatMap((tr: any) => tr.perks.map((p: any) => [p.id, p.name])));
const kvRows = (rows: [string[] | readonly string[], Record<string, string | number>][]): Cell[][] => rows.map(([[k, v], vars]) => [k, fill(v, vars)]);

// Drops: an item, or one weighted roll of a loot table.
const drops = (id: string) => {
  if (!id) return w.none;
  if (!id.startsWith('loot:')) return nameOf(id);
  const table = (loot.tables as Record<string, { item: string; weight: number }[]>)[id.slice(5)];
  const sum = table.reduce((a, e) => a + e.weight, 0);
  return list(table.map((e) => `${e.item ? nameOf(e.item) : 'nothing'} ${pct(e.weight / sum)}`));
};
const req = (r: any) => (r.unlocked ? `${tree[r.unlocked].name} unlocked` : r.skill ? `${tree[r.skill].name} ${r.level}` : r.perk ? perks[r.perk] : nameOf(r.item));
const mobDrops = (ds: any[]) => list(ds.map((x) => `${x.count > 1 ? `${x.count} × ` : ''}${nameOf(x.item)}${x.chance < 1 ? ` (${pct(x.chance)})` : ''}`));
// Passive stats: fractions read as percent; luck, quality, health, stamina and comfort are points.
const stat = (s: string, v: number) => {
  const key = s.split('.')[1];
  const pts = /luck|quality|max_health|stamina_max|comfort/.test(key);
  return `${label(key)} ${v > 0 ? '+' : '−'}${pts ? n(Math.abs(v)) : pct(Math.abs(v))}`;
};
const pendingR = new Set<string>(skills.pending_recipes), pendingA = new Set<string>(skills.pending_abilities);
const isPending = (effects: any[]) => effects.some((e) => (e.recipe && pendingR.has(e.recipe)) || (e.ability && pendingA.has(e.ability)));
const perkText = (p: any) => p.text.replace(/\{(\w+)\}/g, (_: string, k: string) => n(Object.assign({}, ...p.effects.map((e: any) => e.params ?? {}))[k] ?? 0));
const recipeName = (id: string) => nameOf(recipesData.recipes.find((r) => r.id === id)?.output.item ?? id);

const sections: Record<string, () => Table[]> = {
  blocks: () => [{ cols: [c.block, c.tool, c.tier, c.hardness, c.drops, c.xp, c.light],
    rows: blocks.map((b) => [{ icon: b.icon, text: b.name }, none(b.tool === 'none' ? '' : b.tool), String(b.tier), b.hardness < 0 ? w.unbreakable : String(b.hardness), drops(b.drops), none(b.skill), b.light ? String(b.light) : w.none]) }],

  items: () => {
    const of = (kind: string) => itemsData.items.filter((i: any) => i.kind === kind) as any[];
    const food = Object.fromEntries(foods.foods.map((f: any) => [f.item, f]));
    const buffName = (id: string) => buffs.buffs.find((b) => b.id === id)?.name ?? id;
    const effect = (f: any) => list([
      f.golden_of && `${nameOf(f.golden_of)} +${foods.golden_hunger} hunger`,
      f.buff && `${buffName(f.buff)} ${dur(f.buff_s * (f.golden_of ? foods.golden_buff_mult : 1))}`,
      f.poison && `poison ${pct(f.poison)}`,
    ].filter(Boolean)) || w.none;
    return [
      { title: h.tools, cols: [c.item, c.type, c.tier, c.speed, c.durability], rows: of('tool').map((i) => [ic(i.id), i.tool.type, String(i.tool.tier), `× ${n(i.tool.speed)}`, String(i.tool.durability)]) },
      { title: h.weapons, cols: [c.item, c.damage, c.attackSpeed, c.reach, c.durability, c.notes], rows: of('weapon').map((i) => {
        const x = i.weapon;
        const note = x.bow ? `${n(x.bow.draw_s)} s draw, ${n(x.bow.damage)} per ${nameOf(x.bow.ammo)}` : x.block ? `blocks ${pct(x.block)}` : '';
        return [ic(i.id), n(x.damage), n(x.attack_speed), x.reach ? `${n(x.reach)} m` : w.none, String(x.durability), none(note)];
      }) },
      { title: h.armour, cols: [c.item, c.slot, c.armour, c.durability], rows: of('armour').map((i) => [ic(i.id), i.armour.slot, String(i.armour.points), String(i.armour.durability)]) },
      { title: h.food, cols: [c.item, c.hunger, c.saturation, c.effect], rows: of('food').map((i) => {
        const f = food[i.id] ?? {};
        return [ic(i.id), f.golden_of ? n(food[f.golden_of].hunger + foods.golden_hunger) : none(f.hunger), f.golden_of ? n(food[f.golden_of].saturation) : none(f.saturation), effect(f)];
      }) },
      { title: h.materials, cols: [c.item, c.kind, c.stack], rows: itemsData.items.filter((i: any) => !['tool', 'weapon', 'armour', 'food'].includes(i.kind)).map((i: any) => [ic(i.id), i.kind, String(i.stack)]) },
    ];
  },

  crafting: () => [
    ...recipesData.stations.map((s) => ({ title: s.name, cols: [c.output, c.inputs, c.needs, c.xp],
      rows: recipesData.recipes.filter((r) => r.station === s.id).map((r): Cell[] => [
        ic(r.output.item, `${r.output.count > 1 ? `${r.output.count} × ` : ''}${nameOf(r.output.item)}`),
        list(r.inputs.map(stack)),
        r.requires.length ? list(r.requires.map(req)) : r.start ? w.known : w.learnt,
        `${tree[r.skill].name} +${n(r.base_xp)}`,
      ]) })).filter((tb) => tb.rows.length),
    { title: h.fuel, cols: [c.fuel, c.burn], rows: smelting.fuel.map((f) => [ic(f.item), dur(f.seconds)]) },
  ],

  survival: () => {
    const poison = foods.foods.filter((f: any) => f.poison) as any[];
    return [
      { title: h.vitals, cols: [c.setting, c.value], rows: kvRows([
        [kv.health, { hearts: tuning.health_max / 2, half: tuning.health_max }],
        [kv.hunger, { max: tuning.hunger_max, starve: n(tuning.starve_seconds) }],
        [kv.regen, { s: n(tuning.regen_seconds), h: tuning.regen_hunger }],
        [kv.stamina, { max: tuning.stamina_max, sprint: n(tuning.sprint_stamina_per_s), jump: n(tuning.jump_stamina), regen: n(tuning.stamina_regen_per_s), delay: n(tuning.stamina_regen_delay_s) }],
        [kv.breath, { s: n(tuning.breath_seconds), dmg: tuning.drown_damage, i: n(tuning.drown_interval_s) }],
        [kv.fall, { safe: n(tuning.fall_safe_blocks) }],
        [kv.lava, { dmg: tuning.lava_damage, i: n(tuning.lava_interval_s) }],
        [kv.grave, { min: n(tuning.grave_lock_seconds / 60) }],
        [kv.ground, { r: n(tuning.pickup_radius), d: n(tuning.pickup_delay_s), min: n(tuning.item_despawn_s / 60) }],
        [kv.station, { r: tuning.station_radius }],
      ]) },
      { title: h.buffs, cols: [c.buff, c.effect], rows: [
        ...kvRows([
          [kv.buffCap, { cap: buffs.cap }],
          [kv.poison, { foods: list(poison.map((f) => nameOf(f.item))), pct: pct(poison[0].poison), dmg: foods.poison_damage, every: n(foods.poison_every_s), s: n(foods.poison_s) }],
        ]),
        ...buffs.buffs.map((b: any) => [b.name, list([b.regen && `regen +${pct(b.regen)}`, ...Object.entries(b.stats).map(([s, v]) => `${label(s.split('.')[0])} ${stat(s, v as number)}`)].filter(Boolean))]),
      ] },
      { title: h.home, cols: [c.setting, c.value], rows: kvRows([
        [kv.home, { air: home.max_air, sky: home.max_sky_openings, r: home.hearth_radius }],
        [kv.comfort, { cap: home.comfort_cap, blocks: list(home.decor.map(nameOf)) }],
        [kv.rested, { min: n(home.rested_base_min), bonus: n(home.regen_bonus * 100) }],
        [kv.homeXp, { first: home.xp_first_home, per: home.xp_per_comfort }],
      ]) },
    ];
  },

  farming: () => {
    const rar = fish.rarities as Record<string, { xp: number }>;
    return [
      { title: h.crops, cols: [c.crop, c.seed, c.stages, c.grow, c.yield, c.xp, c.golden], rows: crops.crops.map((cr: any) => [
        ic(cr.produce), nameOf(cr.seed), String(cr.stages), dur(cr.grow_s),
        `${range(cr.yield)}${cr.seeds[1] ? ` + ${range(cr.seeds)} ${nameOf(cr.seed)}` : ''}${cr.regrow_stage != null ? ' (regrows)' : ''}`,
        `Harvest +${cr.xp}`, nameOf(cr.golden),
      ]) },
      { title: h.farmland, cols: [c.setting, c.value], rows: kvRows([
        [kv.till, { blocks: list(crops.tillable.map(label)) }],
        [kv.water, { r: crops.moisture_radius, min: n(crops.dry_revert_s / 60) }],
        [kv.golden, { pct: pct(crops.golden_base) }],
        [kv.catchup, { h: n(crops.catchup_cap_s / 3600) }],
        [kv.bite, { min: fish.bite_s[0], max: fish.bite_s[1], w: n(fish.window_s) }],
        [kv.cast, { cast: fish.max_cast, leash: fish.max_leash }],
      ]) },
      ...Object.entries(fish.tables).map(([water, rows]: [string, any[]]) => {
        const sum = rows.reduce((a, e) => a + e.weight, 0);
        return { title: fill(h.water, { water: label(water) }), cols: [c.catch, c.rarity, c.chance, c.size, c.difficulty, c.xp],
          rows: rows.map((e) => [ic(e.item), e.rarity, pct(e.weight / sum), `${range(e.size)} cm`, n(e.difficulty), `Fishing +${rar[e.rarity].xp}`]) };
      }),
    ];
  },

  mobs: () => {
    const mobs = mobsData.mobs.filter((m: any) => m.behaviour !== 'boss') as any[];
    const where = (s: any) => list([s.where === 'cave' ? 'caves' : 'surface', s.on && `on ${list(s.on)}`, s.light_max != null && `light ≤ ${s.light_max}`, `groups of ${range(s.group)}`].filter(Boolean));
    const how = (m: any) => list([
      m.behaviour === 'animal' ? `animal; breeds with ${list(m.breed_food.map(nameOf))}` : m.ranged ? `archer, shoots from ${m.ranged.min}–${m.ranged.max} m` : `melee, ${n(m.windup_s)} s wind-up, ${n(m.reach)} m reach`,
      m.lays && `lays ${nameOf(m.lays.item)} every ${dur(m.lays.every_s)}`,
      m.climber && 'climbs walls', m.poison_s && `poisons for ${m.poison_s} s`, m.burns_in_sun && 'burns in sunlight',
    ].filter(Boolean));
    const row = (m: any): Cell[] => [m.name, String(m.health), m.damage ? String(m.damage) : w.none, how(m), where(m.spawn), mobDrops(m.drops), m.xp_hunting ? `Hunting +${m.xp_hunting}` : w.none];
    const cols = [c.mob, c.health, c.damage, c.behaviour, c.where, c.drops, c.xp];
    const inGame = new Set(mobs.map((m) => m.name));
    return [
      { title: h.hostile, cols, rows: mobs.filter((m) => m.hostile).map(row) },
      { title: h.animals, cols, rows: mobs.filter((m) => !m.hostile).map(row) },
      { title: h.plannedMobs, planned: true, cols: [c.mob, c.where, c.behaviour], rows: design.mobs.filter((m) => !inGame.has(m.mob)).map((m) => [m.mob, m.where, m.behaviour]) },
    ];
  },

  bosses: () => {
    const tables: Table[] = bossesData.bosses.map((b: any) => {
      const gated = recipesData.recipes.filter((r) => r.requires.some((q: any) => q.item === b.trophy));
      return { title: b.name, cols: [c.setting, c.value], rows: kvRows([
        [kv.altar, {}],
        [kv.offering, { items: list(b.offering.map(stack)) }],
        [kv.bossHealth, { hp: mobsData.mobs.find((m) => m.id === b.mob)!.health, extra: n(b.extra_player_health * 100) }],
        [kv.sweep, { dmg: b.sweep.damage, arc: b.sweep.arc_deg, reach: n(b.sweep.reach), w: n(b.sweep.windup_s) }],
        [kv.charge, { dmg: b.charge.damage, min: b.charge.min_range, max: b.charge.max_range, w: n(b.charge.windup_s), cd: n(b.charge.cooldown_s) }],
        [kv.ring, { at: n(b.ring.at_health * 100), dmg: b.ring.damage, r: b.ring.radius, every: n(b.ring.every_s), w: n(b.ring.windup_s) }],
        [kv.leash, { r: b.leash_radius, s: b.leash_s }],
        [kv.loot, { items: mobDrops(b.loot) }],
        [kv.trophy, { trophy: nameOf(b.trophy) }],
        [kv.firstKill, { points: skills.points.boss_first_kill, xp: skills.discoveries.boss_per_tier * b.tier }],
        [kv.opens, { recipes: list(gated.map((r) => `${nameOf(r.output.item)} (${list(r.requires.filter((q: any) => !q.item).map(req))})`)) }],
      ]) };
    });
    const inGame = new Set(bossesData.bosses.map((b) => b.name));
    tables.push({ title: h.plannedBosses, planned: true, cols: [c.boss, c.offering, c.health, c.attacks, c.trophy, c.opens],
      rows: design.bosses.filter((b) => !inGame.has(b.boss.split(',')[0])).map((b) => [b.boss, b.offering, b.health_1_player, b.phases_and_attacks, b.trophy, b.opens]) });
    return tables;
  },

  skills: () => {
    const sp = skills.spec_curve;
    const xpText = Object.fromEntries(design.trees.map((tr) => [tr.name, tr.text.replace(/^XP: /, '').replace(/,? §\d+\)| \(§\d+[^)]*\)| under the §\d+ limits|;? (new-cell rule in|Anti-exploit:) §\d+\./g, (m) => (m.endsWith(')') && !m.startsWith(' (') ? ')' : ''))]));
    const unlocks = (tr: any) => list(tr.milestones.flatMap((m: any) => m.effects.filter((e: any) => e.recipe).map((e: any) => `${recipeName(e.recipe)} (${m.level})${pendingR.has(e.recipe) ? ' *' : ''}`))) || w.none;
    return [
      { title: h.rules, cols: [c.setting, c.value], rows: kvRows([
        [kv.points, { start: skills.points.start, per: skills.points.per_level, five: skills.points.every_5_levels, boss: skills.points.boss_first_kill }],
        [kv.unlock, { cost: skills.costs.unlock_tree }],
        [kv.levels, { cap: skills.player_xp.cap, max: skills.skill_curve.max }],
        [kv.discoveries, skills.discoveries],
        [kv.locked, { pct: n(skills.locked.speed * 100) }],
        [kv.specs, { slots: list(sp.slots_at.map(String)), cost: skills.costs.third_spec_slot, max: sp.max }],
        [kv.death, { normal: n(skills.death.normal_loss * 100), hard: n(skills.death.hardcore_loss * 100) }],
        [kv.respec, { h: n(skills.respec.cooldown_s / 3600), pct: n(skills.respec.restore * 100) }],
      ]) },
      { title: h.trees, cols: ['#', c.tree, c.xp, c.passives, c.unlocks, c.specs], rows: skills.trees.map((tr: any, i: number) => [
        String(i + 1).padStart(2, '0'), tr.name, none(xpText[tr.name]),
        list(tr.passives.map((p: any) => stat(p.stat, p.per_level))),
        unlocks(tr), list(tr.specs.targets.map((s: any) => s.name)),
      ]) },
      ...skills.trees.filter((tr: any) => tr.perks.length).map((tr: any) => ({ title: fill(h.perks, { tree: tr.name }), cols: [c.perk, c.level, c.cost, c.branch, c.effect],
        rows: tr.perks.map((p: any) => [`${p.name}${isPending(p.effects) ? ' *' : ''}`, String(p.level), String(p.cost), p.branch, perkText(p)]) })),
    ];
  },

  world: () => [
    { title: d.home.world.kicker, cols: [c.tier, c.where, c.biomes, c.materials, c.boss], rows: design.tiers.map((r) => [r.tier, r.where, r.biomes, r.new_materials, r.boss_altar_biome]) },
    { title: c.ore, cols: [c.ore, c.tier, c.height, c.ring, c.drops, c.xp], rows: design.ores.map((r) => [r.ore, r.tool_tier, r.height, r.ring, r.drops, r.mining_xp]) },
  ],
};
const tables = sections[section.id]();
const num = (v: Cell) => typeof v === 'string' && /^[\d.×%−+–\s-]+$/.test(v) && /\d/.test(v);
const marked = section.id === 'skills' || section.id === 'crafting';
---
<Page locale={locale} active="wiki" biome={section.biome} kicker={planned ? d.status.planned : d.status.inGame} title={title} lede={lede}>
  <nav class="gr-crumbs" slot="crumbs"><a href={href(locale, '/wiki/')}>{w.title}</a><Icon name="chevronRight" /><span>{title}</span></nav>
  <p class="rc-note"><Icon name="info" />{planned ? w.plannedNote : fill(w.inGameNote, { date: status.synced })}{w.dataNote && ` ${w.dataNote}`}{marked && ` ${w.pendingNote}`}</p>
  {tables.map((tb) => (
    <>
      {tb.title && <h2 class="gr-section-h">{tb.title}{tb.planned && <> <Tag>{d.status.planned}</Tag></>}</h2>}
      <div class="rc-table" lang="en" data-stack>
        <table>
          <thead><tr>{tb.cols.map((col) => <th lang={locale}>{col}</th>)}</tr></thead>
          <tbody>{tb.rows.map((row) => <tr>{row.map((cell, i) => typeof cell === 'string'
            ? <td class:list={[num(cell) && 'num']} data-label={tb.cols[i]} lang={tb.cols[0] === c.setting && i === 1 ? locale : undefined}>{cell}</td>
            : <td data-label={tb.cols[i]}><span class="rc-cell"><img src={asset(`/game/blocks/${cell.icon}.png`)} alt="" width="24" height="24" loading="lazy" />{cell.text}</span></td>)}</tr>)}</tbody>
        </table>
      </div>
    </>
  ))}
  <nav class="gr-panel-cta">
    {SECTIONS.filter((s) => s.id !== section.id).map((s) => <a class="gr-btn gr-btn-secondary gr-btn-sm" href={href(locale, `/wiki/${s.id}/`)}>{w.sections[s.id][0]}</a>)}
  </nav>
</Page>
