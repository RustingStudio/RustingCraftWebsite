---
import { getCollection } from 'astro:content';
import Page from '../../../layouts/Page.astro';
import Icon from '../../../components/Icon.astro';
import { localePaths, localeOf, t, href, asset } from '../../../i18n';
export const getStaticPaths = localePaths;
const locale = localeOf(Astro.params.locale);
const d = t(locale), p = d.devlog;
const posts = (await getCollection('devlog')).sort((a, b) => b.data.milestone - a.data.milestone);
const date = (x: Date) => x.toISOString().slice(0, 10);
---
<Page locale={locale} active="devlog" biome="forest" kicker="RustingCraft" title={p.title} lede={p.lede}>
  {p.enOnly && <p class="rc-note"><Icon name="info" />{p.enOnly}</p>}
  <div class="rc-grid rc-grid-wide">
    {posts.map((post) => (
      <a class="rc-card-media" href={href(locale, `/devlog/${post.id}/`)} lang="en">
        {post.data.cover && <img src={asset(post.data.cover)} alt="" loading="lazy" decoding="async" />}
        <div><small>M{post.data.milestone} · {date(post.data.date)}</small><b>{post.data.title}</b><p>{post.data.description}</p></div>
      </a>
    ))}
  </div>
</Page>
